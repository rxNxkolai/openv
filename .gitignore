# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Model weights (downloaded, never committed)
*.pth
*.pt
*.onnx
models/

# Data and output (video never enters git)
# data/* rather than data/, because git will not descend into an excluded
# directory and the negation below would never be consulted.
data/*
out/

# Zone polygons and floor calibrations are small text config, not footage, and
# they are the other half of how the test fixtures were produced. Without them
# the fixtures cannot be regenerated or argued with.
!data/*.zones.json
!data/*.floor.json

# Env
.env
.env.local

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local tooling caches
.impeccable/

# Shell-redirect artifacts: inline python containing > or < can leave
# zero-byte files named after fragments of the expression.
*[<>]*
maximum_frames_without_update
